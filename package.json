{
  "name": "tower",
  "version": "0.4.0",
  "private": true,
  "description": "A control tower for pi coding-agent sessions: a swimlane board that plans, builds and tests work across projects.",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "orchestrator",
    "kanban"
  ],
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./pi/tower.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel --filter @tower/daemon --filter @tower/web dev",
    "build": "pnpm --filter @tower/web build",
    "start": "pnpm --filter @tower/daemon start"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
